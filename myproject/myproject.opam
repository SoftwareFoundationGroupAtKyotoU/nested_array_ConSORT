opam-version: "2.0"
synopsis: "Ownership refinement type inference for nested arrays"
description: "Automated ownership type inference and refinement type checking for imperative programs with pointer arithmetic and nested arrays"
maintainer: ["Kohei Suenaga <ksuenaga@fos.kuis.kyoto-u.ac.jp>"]
authors: ["Yusuke Fujiwara" "Yusuke Matsushita" "Kohei Suenaga" "Atsushi Igarashi"]
license: "Apache-2.0"
tags: ["ownership-types" "refinement-types" "verification" "nested-arrays"]
homepage: "https://github.com/SoftwareFoundationGroupAtKyotoU/nested_array_ConSORT"
bug-reports: "https://github.com/SoftwareFoundationGroupAtKyotoU/nested_array_ConSORT/issues"
depends: [
  "ocaml" {>= "4.13"}
  "dune" {>= "2.7"}
  "odoc" {with-doc}
  "zarith"
  "menhir"
  "ounit2"
  "ppx_deriving"
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/SoftwareFoundationGroupAtKyotoU/nested_array_ConSORT.git"
