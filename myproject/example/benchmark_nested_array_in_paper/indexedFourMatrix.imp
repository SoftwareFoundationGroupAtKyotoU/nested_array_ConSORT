init(n, p) 
[ <#n: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    /* q : A x1 . int ref [ 0, -2 + 1 * n] -> 1.0 */
    /* p : A x1 . int ref [ 0, 0] -> 1.0 */

    let m = n - 1 in
    let d = init(m, q) in
    /* q : A x1 . int ref [ 0, -2 + 1 * n] -> 1.0 */

    alias(q=p+1);
    /* q : A x1 . int ref [ 4859 + -1 * n, 4859 + -1 * n] -> 0.0 */
    /* p : A x1 . int ref [ 0, -1 + 1 * n] -> 1.0 */

    1
  }
}



iM(k, pp)
[ <#k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#k: int, pp: int ref(0 , k- i_2 - 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 then { 
    let r = alloc k : int ref in
    /* r : A x1. int ref [ 0, -1 + 1 * k] -> 1.0 */

    let d = init(k, r) in
    /* r : A x1. int ref [ 0, -1 + 1 * k] -> 1.0 */

    pp := r;
    /* pp : A x2 . A x1 . 
                  int ref x2 = 0 /\ [ 0 + -1 * x2, -1 + -1 * x2 + 1 * k] -> 1.0, x2 != 0 /\ [ 0, 0] -> 0.0
                      ref [ 0, 0] -> 1.0, [ 1, -1 + 1 * k] -> 1.0 */
    /* r : A x1 . int ref [ 4859, 4859] -> 0.0 */

    let q = pp + 1 in
    /* q : A x2 . A x1 . 
           int ref [ 0, 0] -> 0.0 
               ref [ 0, -2 + 1 * k] -> 1.0 */
    /* pp : A x2 . A x1 . 
              int ref [ 0 + -1 * x2, -1 + -1 * x2 + 1 * k] -> 1.0 
                  ref [ 0, 0] -> 1.0 */

    let m = k - 1 in
    let d2 = iM(m, q) in
    /* q : A x2 . A x1 . 
            int ref [ 0, -2 + -1 * x2 + 1 * k] -> 1.0
                ref [ 0, -2 + 1 * k] -> 1.0 */

    alias(q=pp+1);
    /* q : A x2 . A x1 . 
            int ref [ 4859 + -1 * k, 4859 + -1 * k] -> 0.0
                ref [ -2 + 1 * k, 4859 + 1 * k] -> 0.0 */
    /* pp : A x2 . A x1 . 
            int ref [ 0, -1 + -1 * x2 + 1 * k] -> 1.0
                ref [ 0, -1 + 1 * k] -> 1.0 */

    0
  } else {
    0
  }
}

iTm(m, ppp)
[ <#m: int, ppp: int ref(0, 0, 0.) ref(0, 0, 0.) ref(0, m - 1, 1.)> ->
    <#m: int, ppp: int ref(0 , m- i_2 - i_3 - 1, 1.) ref(0 , m- i_3 - 1, 1.) ref(0, m - 1, 1.) | int> ]
{ 
  if m > 0 then { 
    let r = alloc m : int ref ref in
    /* r : A x2 . A x1 . 
            int ref [ 0 + -1 * x2 + -1 * m, 0 + -1 * x2 + -1 * m] -> 0.0 -> 0.0
                ref [ 0, -1 + 1 * m] -> 1.0 */

    let d = iM(m, r) in
    /* r : A x2 . A x1 . 
            int ref [ 0, -1 + -1 * x2 + 1 * m] -> 1.0
                ref [ 0, -1 + 1 * m] -> 1.0 */

    ppp := r;
    /* pp : A x3 . A x2 . A x1 . 
            int ref x3 = 0 /\ [ 0 + -1 * x3, -1 + -1 * x2 + -1 * x3 + 1 * m] -> 1.0 -> 1.0, x3 != 0 /\ [ 0 + -1 * x2, 0 + -1 * x2] -> 0.0
                ref x3 = 0 /\ [ 0 + -1 * x3, -1 + -1 * x3 + 1 * m] -> 1.0 -> 1.0, x3 != 0 /\ [ 0, 0] -> 0.0
                ref [ 0, 0] -> 1.0, [ 1, -1 + 1 * m] -> 1.0 */
    /* r : A x2 . A x1 . 
            int ref [ 4859 + -1 * x2 + -1 * m, 4859 + -1 * x2 + -1 * m] -> 0.0
                ref [ 4859 + 1 * m, 572 + -1 * m] -> 0.0 */

    let q = ppp + 1 in
    /* q : A x3 . A x2 . A x1 .
            int ref [ 0 + -1 * x2, 0 + -1 * x2] -> 0.0
                ref [ 0, 0] -> 0.0
                ref [ 0, -2 + 1 * m] -> 1.0 */
    /* ppp : A x3 . A x2 . A x1 . 
              int ref [ 0 + -1 * x3h, -1 + -1 * x2 + -1 * x3 + 1 * m] -> 1.0
                  ref [ 0 + -1 * x3, -1 + -1 * x3 + 1 * m] -> 1.0
                  ref [ 0, 0] -> 1.0 */

    let u = m - 1 in
    let d2 = iTm(u, q) in
    /* q : A x3 . A x2 . A x1 .
            int ref [ 0, -2 + -1 * x2 + -1 * x3 + 1 * m] -> 1.0
                ref [ 0, -2 + -1 * x3 + 1 * m] -> 1.0
                ref [ 0, -2 + 1 * m] -> 1.0 */

    alias(q=ppp+1);
    /* q : A x3 . A x2 . A x1 .
            int ref [ 4859 + -1 * x2 + -1 * x3 + -1 * m, 4859 + -1 * x2 + -1 * m] -> 0.0
                ref [ 4859, 4859 + -1 * m] -> 0.0
                ref [ 290 + -1 * m, 4859 + -1 * m] -> 0.0 */
    /* ppp : A x3 . A x2 . A x1 .
            int ref [ 0, -1 + -1 * x2 + -1 * x3 + 1 * m] -> 1.0
                ref [ 0, -1 + -1 * x3 + 1 * m] -> 1.0
                ref [ 0, -1 + 1 * m] -> 1.0 */

    0
  } else {
    0
  }
}

iFm(j, pppp)
[ <#j: int, pppp: int ref(0, 0, 0.) ref(0, 0, 0.) ref (0, 0, 0.) ref(0, j - 1, 1.)> ->
    <#j: int, pppp: int ref (0, j - i_2 - i_3 - i_4 - 1, 1. ) ref(0 , j- i_3 - i_4 - 1, 1.) 
                                            ref(0 , j- i_4 - 1, 1.) ref(0, j - 1, 1.) | int> ]
{ 
  if j > 0 then { 
    let r = alloc j : int ref ref ref in
    /* r : A x3 . A x2 . A x1 .
            int ref [ 0 + -1 * x2 + -1 * x3 + -1 * j, 0 + -1 * x2 + -1 * x3 + -1 * j] -> 0.0
                ref [ 0 + -1 * x3 + -1 * j, 0 + -1 * x3 + -1 * j] -> 0.0
                ref [ 0, -1 + 1 * j] -> 1.000000 */

    let d = iTm(j, r) in
    /* r : A x3 . A x2 . A x1 .
            int ref [ 0, -1 + -1 * x2 + -1 * x3 + 1 * j] -> 1.0
                ref [ 0, -1 + -1 * x3 + 1 * j] -> 1.0
                ref [ 0, -1 + 1 * j] -> 1.0 */

    pppp := r;
    /* pppp : A x4 . A x3 . A x2 . A x1 .
              int ref x4 = 0 /\ [ 0 + -1 * x4, -1 + -1 * x2 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0, x4 != 0 /\ [ 0 + -1 * x2 + -1 * x3, 0 + -1 * x2 + -1 * x3] -> 0.0
                  ref x4 = 0 /\ [ 0 + -1 * x4, -1 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0, x4 != 0 /\ [ 0 + -1 * x3, 0 + -1 * x3] -> 0.0
                  ref x4 = 0 /\ [ 0 + -1 * x4, -1 + -1 * x4 + 1 * j] -> 1.0, x4 != 0 /\ [ 0, 0] -> 0.0
                  ref [ 0, 0] -> 1.0, [ 1, -1 + 1 * j] -> 1.0 */ 
    /* r : A x3 . A x2 . A x1 . 
            int ref [ 4859 + -1 * x2 + -1 * x3h + -1 * j, 4859 + -1 * x2 + -1 * x3 + -1 * j] -> 0.0
                ref [ 4859 + -1 * x3 + -1 * j, 4859 + -1 * x3 + -1 * j] -> 0.0
                ref [ 4859 + -1 * j, 4859 + -1 * j] -> 0.0 */

    let q = pppp + 1 in
    /* q : A x4 . A x3 . A x2 . A x1 .
            int ref [ 0 + -1 * x2 + -1 * x3, 0 + -1 * x2 + -1 * x3] -> 0.0
                ref [ 0, 0] -> 0.0
                ref [ 0, 0] -> 0.0
                ref [ 0, -2 + 1 * j] -> 1.0 */
    /* pppp : A x4 . A x3 . A x2 . A x1 .
                  int ref [ 0 + x4, -1 + -1 * x2 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                      ref [ 0 + -1 * x4, -1 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                      ref [ 0 + -1 * x4, -1 + 1 * j] -> 1.0
                      ref [ 0, 0] -> 1.0 */

    let u = j - 1 in
    let d2 = iFm(u, q) in
    /* q : A x4 . A x3 . A x2 . A x1 .
            int ref [ 0, -2 + -1 * x4 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -2 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -2 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -2 + 1 * j] -> 1.0 */

    alias(q=pppp+1);
    /* q : A x4 . A x3 . A x2 . A x1 .
            int ref [ 4859 + -1 * x2 + -1 * x3 + -1 * x4 + -1 * j, 4859 + -1 * x2 + -1 * x3 + -1 * x4 + -1 * j] -> 0.0
                ref [ 4859 + -1 * x3 + 1 * x4 + -1 * j, 4859 + -1 * x3 + -1 * x4 + -1 * j] -> 0.0
                ref [ 4859 + -1 * x4 + -1 * j, 4859 + -1 * x4 + -1 * j] -> 0.0
                ref [ 4859 + -1 * j, 4859 + -1 * j] -> 0.0 */
    /* pppp : A x4 . A x3 . A x2 . A x1 .
            int ref [ 0, -1 + -1 * x2 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -1 + -1 * x3 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -1 + -1 * x4 + 1 * j] -> 1.0
                ref [ 0, -1 + 1 * j] -> 1.0 */
                
    0
  } else {
    0
  }
}

{
  let p = alloc 10 : int ref ref ref ref in
  /* p : A x4. A x3 . A x2 . A x1 .
          int ref [ 0 + -1 * x2 + -1 * x3 + -1 * x4, 0 + -1 * x2 + -1 * x3 + -1 * x4] -> 0.0
              ref [ 0 + -1 * x3 + -1 * x4, 0 + -1 * x3 + -1 * x4] -> 0.0
              ref [ 0 + -1 * x4, 0 + -1 * x4] -> 0.0
              ref [ 0, 9] -> 1.0 */

  let ten = 10 in
  let d = iFm(ten, p) in
  /* p : A x4 . A x3 . A x2 . A x1 .
         int ref [ 0, 9 + -1 * x2 + -1 * x3 + -1 * x4] -> 1.0
             ref [ 0, 9 + -1 * x3 + -1 * x4] -> 1.0
             ref [ 0, 9 + -1 * x4] -> 1.0 
             ref [ 0, 9] -> 1.0 */

  let ind1 = _ : (ind1 >= 0 && ind1 < 10) in
  let ind2 = _ : (ind2 >= 0 && ind2 < 9 - ind1) in
  let ind3 = _ : (ind3 >= 0 && ind3 < 9 - ind1 - ind2) in
  let ind4 = _ : (ind4 >= 0 && ind4 < 9 - ind1 - ind2 - ind3) in
  assert(p[ind1][ind2][ind3][ind4] = 1);
  ()
}

