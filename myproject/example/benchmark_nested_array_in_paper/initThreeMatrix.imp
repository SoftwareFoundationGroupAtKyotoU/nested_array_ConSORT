init(n, p) 
[ <#n: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    /* q : A x1 . int ref [ 0, -2 + 1 * n] -> 1.0 */
    /* p : A x1 . int ref [ 0, 0] -> 1.0 */

    let m = n - 1 in
    let d = init(m, q) in
    /* q : A x1 . int ref [ 0, -2 + 1 * n] -> 1.0 */

    alias(q=p+1);
    /* q : A x1 . int ref [ 571 + -1 * n, 571 + -1 * n] -> 0.0 */
    /* p : A x1 . int ref [ 0, -1 + 1 * n] -> 1.0 */

    1
  }
}

iM(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    /* r : A x1. int ref [ 0, -1 + 1 * l] -> 1.0 */

    let d = init(l, r) in
    /* r : A x1. int ref [ 0, -1 + 1 * l] -> 1.0 */

    pp := r;
    /* pp : A x2 . A x1 . 
                  int ref x2 = 0 /\ [ 0 + -1 * x2, -1 + -1 * x2 + 1 * l] -> 1.0, x2 != 0 /\ [ 0, 0] -> 0.0
                      ref [ 0, 0] -> 1.0, [ 1, -1 + 1 * k] -> 1.0 */
    /* r : A x1 . int ref [ 571 + -1 * l + -1 * k, 571 + -1 * l + -1 * k] -> 0.0 */

    let q = pp + 1 in
    /* q : A x2 . A x1 . 
           int ref [ 0, 0] -> 0.0 
               ref [ 0, -2 + 1 * k] -> 1.0 */
    /* pp : A x2 . A x1 . 
              int ref [ 0 + -1 * x2, -1 + -1 * x2 + 1 * l] -> 1.0 
                  ref [ 0, 0] -> 1.0 */

    let m = k - 1 in
    let d2 = iM(l, m, q) in
    /* q : A x2 . A x1 . 
            int ref [ 0, -1 + 1 * l] -> 1.0
                ref [ 0, -2 + 1 * k] -> 1.0 */

    alias(q=pp+1);
    /* q : A x2 . A x1 . 
            int ref [ 571 + -1 * x2 + -1 * l + -1 * k, 571 + -1 * x2 + -1 * l + -1 * k] -> 0.0
                ref [ -7 + 1 * l + 1 * k, 39 + -1 * l + -1 * k] -> 0.0 */
    /* pp : A x2 . A x1 . 
            int ref [ 0, -1 + 1 * l] -> 1.0
                ref [ 0, -1 + 1 * k] -> 1.0 */

    0
  } else {
    0
  }
}

iTm(ll, kk, ppp)
[ <#ll: int, #kk: int, ppp: int ref (0, 0, 0.) ref(0, 0, 0.) ref(0, kk - 1, 1.)> ->
    <#ll: int, #kk: int, ppp: int ref (0, ll- 1, 1.) ref(0 , ll - 1, 1.) ref(0, kk - 1, 1.) | int> ]
{ 
  if kk > 0 && ll > 0 then { 
    let rr = alloc ll : int ref ref in
    /* rr : A x2 . A x1 . 
            int ref [ 0 + -1 * x2 + -1 * ll + -1 * kk, 0 + x2 + -1 * ll + -1 * kk] -> 0.0 ref [ 0, -1 + 1 * ll] -> 1.000000 */

    let d = iM(ll, ll, rr) in
    /* rr : A x2 . A x1 . 
            int ref [ 0, -1 + 1 * ll] -> 1.0 ref [ 0, -1 + 1 * ll] -> 1.0 */

    ppp := rr;
    /* eq0 : A x3 . A x2 . A x1 .
            int ref x3 = 0 /\ [ 0 + -1 * x3, -1 + -1 * x3 + 1 * ll] -> 1.0, x3 != 0 /\ [ 0 + -1 * x3, 0 + -1 * x3] -> 0.0
                ref x3 = 0 /\ [ 0 + -1 * x3, -1 + -1 * x3 + 1 * ll] -> 1.0, x3 != 0 /\ [ 0, 0] -> 0.0
                ref [ 0, 0] -> 1.0, [ 1, -1 + 1 * iTmkk] -> 1.0 */
    /* rr : A x2 . A x1 .
            int ref [ 571 + -1 * x2 + -1 * ll + -1 * kk, 571 + -1 * x2 + -1 * ll + -1 * kk] -> 0.0 ref [ 19 + -1 * ll, 571 + -1 * ll + -1 * kk] -> 0.0 */
    
    let qq = ppp + 1 in
    /* qq : A x3 . A x2 . A x1 .
            int ref [ 0 + -1 * x2, 0 + -1 * x2] -> 0.0 
                ref [ 0, 0] -> 0.0
                ref [ 0, -2 + 1 * kk] -> 1.0 */
    /* ppp :  A x3 . A x2 . A x1 .
              int ref [ 0 + -1 * x3, -1 + -1 * x3 + 1 * ll] -> 1.0
                  ref [ 0 + -1 * x3, -1 + -1 * x3 + 1 * ll] -> 1.0
                  ref [ 0, 0] -> 1.0 */

    let mm = kk - 1 in
    let d2 = iTm(ll, mm, qq) in
    /* qq : A x3 . A x2 . A x1 .
            int ref [ 0, -1 + 1 * ll] -> 1.0
                ref [ 0, -1 + 1 * ll] -> 1.0
                ref [ 0, -2 + 1 * kk] -> 1.0 */

    alias(qq=ppp+1);
    /* qq : A x3 . A x2 . A x1 .
            int ref [ 571 + -1 * x2 + -1 * x3 + -1 * ll + -1 * kk, 571 + -1 * x2 + -1 * x3 + -1 * ll + -1 * kk] -> 0.0
                ref [ 571 + x3 + -1 * ll + -1 * kk, 571 + -1 * x3 + -1 * ll + -1 * kk] -> 0.0
                ref [ 571 + -1 * ll + -1 * kk, 571 + -1 * ll + -1 * kk] -> 0.0 */
    /* ppp :  A x3 . A x2 . A x1 .
              int ref [ 0, -1 + 1 * ll] -> 1.0
                  ref [ 0, -1 + 1 * ll] -> 1.0
                  ref [ 0, -1 + 1 * kk] -> 1.0 */

    0
  } else {
    0
  }
}

{
  let x = _ : (x > 0) in
  let p = alloc x : int ref ref ref in
  /* p : A x3. A x2. A x1. 
         int ref [ 0 + -1 * x2 + -1 * x3 + -1 * x, 0 + -1 * x2 + -1 * x3 + -1 * x] -> 0.0
             ref [ 0 + -1 * x3 + -1 * x, 0 + -1 * x3 + -1 * x] -> 0.0
             ref [ 0, -1 + 1 * x] -> 1.0 */

  let d = iTm(x, x, p) in
  /* p : A x3. A x2. A x1. 
        int ref [ 0, -1 + 1 * x] -> 1.0
            ref [ 0, -1 + 1 * x] -> 1.0
            ref [ 0, -1 + 1 * x] -> 1.0 */

  let ind1 = _ : (ind1 >= 0 && ind1 < x) in
  let ind2 = _ : (ind2 >= 0 && ind2 < x) in
  let ind3 = _ : (ind3 >= 0 && ind3 < x) in
  assert(p[ind1][ind2][ind3] = 1);
  1
}

