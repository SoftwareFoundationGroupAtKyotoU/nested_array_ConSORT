init(n, x, p) 
[ <#n: int, #x: int, p: int ref  > -> 
  <#n: int, #x: int, p: int ref| int> ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, x, q) in
    1
  }
}

{
  let tt = mkarray 10 in
  let tt2 = mkarray 10 in
  let one = 1 in
  let ten = 10 in
  let d = init(ten, one, tt) in
  let j = *tt in
  assert(j = 1);
  let d2 = init(ten, ten, tt2) in
  ()
}

