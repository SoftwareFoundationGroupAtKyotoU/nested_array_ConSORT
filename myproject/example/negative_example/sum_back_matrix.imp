init(pin, p) 
[ <#pin: int, p: int ref (0, pin - 1, 1.) > -> 
  <#pin: int, p: int ref (0, pin - 1, 1.) | int> ]
{
  if pin <= 0 then {
    1
  } else {
    p := 0;
    let q = p + 1 in
    let m1 = pin - 1 in
    let d = init(m1, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = initMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

sum(plen, p) 
[ <#plen: int, p: int ref(0, plen - 1, 1.)> -> 
  <#plen: int, p: int ref(0, plen - 1, 1.) | int> ]
{
  if plen <= 0 then {
    0
  } else {
    let x = *p in
    let q = p + 1 in
    let m = plen - 1 in
    let s = sum(m, q) in
    let y = x + s in
    alias(q = p + 1);
    y
  }
}

sumMatrix(n1, n2, q) 
[ <#n1: int, #n2: int, q: int ref(0 , n1- 1, 1.) ref(0, n2 - 1, 1.) > -> 
  <#n1: int, #n2: int, q: int ref(0 , n1- 1, 1.) ref(0, n2 - 1, 1.) | int> ]
{
  if n1 > 0 && n2 > 0 then {
    let m = n2 - 1 in
    let q2 = q + m in
    let q2in = *q2 in
    let s = sum(n1, q2in) in
    alias(q2in = *q2);
    alias(q2 = q + m);
    let q3 = q + 1 in
    let m = n2 - 1 in
    let y = sumMatrix(n1, m, q3) in
    alias(q3 = q + 1);
    let z = s + y in
    z
  } else {
    0
  }
}

{
  let mat1 = alloc 10 : int ref ref in
  let ten = 10 in
  let d1 = initMatrix(ten, ten, mat1) in
  let d2 = sumMatrix(ten, ten, mat1) in
  assert(d2 >= 0);
  1
}