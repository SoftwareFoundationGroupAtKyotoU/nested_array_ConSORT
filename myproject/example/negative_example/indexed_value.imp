init(n1, val, p1) 
[ <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.)> -> 
  <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.) | int> ]
{
  if n1 <= 0 then {
    1
  } else {
    p1 := val;
    let q = p1 + 1 in
    let m = n1 - 1 in
    let d = init(m, val, q) in
    alias(q = p1 + 1);
    1
  }
}


easyMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, l- 1, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, k, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = easyMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

verify(s, s2, q)
[ <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.)> ->
    <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.) | int> ]
{
  if s > 0 then { 
    let ind1 = _ : (ind1 >= 0 && ind1 < s) in
    let ind2 = _ : (ind2 >= 0 && ind2 < s) in
    let val = s - ind1 in
    assert(q[ind1][ind2] = val);
    1
  } else {
    0
  }
}


{
  let ten = _ : (ten > 0) in
  let pp = alloc ten : int ref ref in
  let d = easyMatrix(ten, ten, pp) in
  let d2 = verify(ten, ten, pp) in
  ()
}