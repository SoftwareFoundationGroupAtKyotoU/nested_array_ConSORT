init(n, p) 
[ <#n: int, p: int ref (0, n - 1, 1.) > -> 
  <#n: int, p: int ref (0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    1
  }
}



easyMatrix(k, pp)
[ <#k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#k: int, pp: int ref(0 , k- i_2 - 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 then { 
    let r = alloc k : int ref in
    let d = init(k, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = easyMatrix(m, q) in
    0
  } else {
    0
  }
}


{
  let p = alloc 10 : int ref ref in
  let ten = 10 in
