init(pin, p) 
[ <#pin: int, p: int ref (0, pin - 1, 1.) > -> 
  <#pin: int, p: {v:int| (=> ((i1 >= 0) and (i1 < pin) ) (v = 1))} ref (0, pin - 1, 1.) | int> ]
{
  if pin <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    let m1 = pin - 1 in
    let d = init(m1, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: 
    {v:int| (=> ((((i1 >= 0) and (i1 < l)) and (i2 >= 0)) and (i2 < k)) (v = 1))} ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = initMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

sum(plen, p) 
[ <#plen: int, p: {v:int| (=> ((i1 >= 0) and (i1 < plen) ) (v = 1))} ref(0, plen - 1, 1.)> -> 
  <#plen: int, p: {v:int| (=> ((i1 >= 0) and (i1 < plen) ) (v = 1))} ref(0, plen - 1, 1.) | int> ]
{
  if plen <= 0 then {
    0
  } else {
    let x = *p in
    assert(x = 1);
    let q = p + 1 in
    let m = plen - 1 in
    let s = sum(m, q) in
    let y = x + s in
    alias(q = p + 1);
    assert(y = plen);
    y
  }
}

sumMatrix(n1, n2, shift, q) 
[ <#n1: int, #n2: int, #shift:int, q: {v:int| (=> ((((i1 >= 0) and (i1 < n1)) and (i2 >= 0)) and (i2 < n2)) (v = 1))} ref(0 , n1- 1, 1.) ref(0, n2 - 1, 1.) > -> 
  <#n1: int, #n2: int, #shift:int, q: int ref(0 , n1- 1, 1.) ref(0, n2 - 1, 1.) | int> ]
{
  if n1 > 0 && n2 > 0 && n2 >= shift && shift > 0 then {
    let nex = shift - 1 in
    let q2 = q + nex in
    let q2in = *q2 in
    let s = sum(n1, q2in) in
    assert(s = n1);
    alias(q2in = *q2);
    alias(q2 = q + nex);
    let y = sumMatrix(n1, n2, nex, q) in
    let z = s + y in
    z
  } else {
    0
  }
}

{
  let ten = 4 in
  let mat1 = alloc ten : int ref ref in
  let d1 = initMatrix(ten, ten, mat1) in
  let d2 = sumMatrix(ten, ten, ten, mat1) in
  let ind1 = _ : (ind1 >= 0 && ind1 < ten) in
  let ind2 = _ : (ind2 >= 0 && ind2 < ten) in
  /*assert(mat1[ind1][ind2] = 1);*/
  assert(d2 >= 16);
  1
}
