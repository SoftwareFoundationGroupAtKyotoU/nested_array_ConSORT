fun_name:init 
ownership
initp b : ref^1 [ 0, -1 + 1 * initpin] -> 1.000000
initp e : ref^1 [ 0, -1 + 1 * initpin] -> 1.000000
if exp then {
  } else {
  initp := (int);
  let q = initp + 1 in
/* q : ref^1 [ 0, -2 + 1 * initpin] -> 1.000000 */
/* initp : ref^1 [ 0, 0] -> 1.000000 */
  let _ = init(not yet implemented, q) in
/* q : ref^1 [ 0, -2 + 1 * initpin] -> 1.000000 */
  alias(q=initp+1);
/* q : ref^1 [ 4859 + -1 * initpin, 4859 + -1 * initpin] -> 0.000000 */
/* initp : ref^1 [ 0, -1 + 1 * initpin] -> 1.000000 */
}

fun_name:initMatrix 
ownership
initMatrixpp b : ref^2 [ 0, -1 + 1 * initMatrixk] -> 1.000000
initMatrixpp b : ref^1 [ 0, 0] -> 0.000000
initMatrixpp e : ref^2 [ 0, -1 + 1 * initMatrixk] -> 1.000000
initMatrixpp e : ref^1 [ 0, -1 + 1 * initMatrixl] -> 1.000000
if exp then {
    let r = alloc initMatrixl : int ref in
/* r : ref^1 [ 0, -1 + 1 * initMatrixl] -> 1.000000 */
  let _ = init(initMatrixl, r) in
/* r : ref^1 [ 0, -1 + 1 * initMatrixl] -> 1.000000 */
  initMatrixpp := r;
/* initMatrixpp_eq0 : ref^2 [ 0, 0] -> 1.000000 */
/* initMatrixpp_eq0 : ref^1 [ 0 + -1 * i_2_initMatrixpp_eq0_2th, -1 + -1 * i_2_initMatrixpp_eq0_2th + 1 * initMatrixl] -> 1.000000 */
/* initMatrixpp_non0 : ref^2 [ 0, -2 + 1 * initMatrixk] -> 1.000000 */
/* initMatrixpp_non0 : ref^1 [ 0, 0] -> 0.000000 */
/* r : ref^1 [ 4859 + -1 * initMatrixk, 4859 + -1 * initMatrixl + -1 * initMatrixk] -> 0.000000 */
  let q = initMatrixpp + 1 in
/* q : ref^2 [ 0, -2 + 1 * initMatrixk] -> 1.000000 */
/* q : ref^1 [ 0, 0] -> 0.000000 */
/* initMatrixpp : ref^2 [ 0, 0] -> 1.000000 */
/* initMatrixpp : ref^1 [ 0 + -1 * i_2_initMatrixpp_2th, -1 + -1 * i_2_initMatrixpp_2th + 1 * initMatrixl] -> 1.000000 */
  let _ = initMatrix(initMatrixl, not yet implemented, q) in
/* q : ref^2 [ 0, -2 + 1 * initMatrixk] -> 1.000000 */
/* q : ref^1 [ 0, -1 + 1 * initMatrixl] -> 1.000000 */
  alias(q=initMatrixpp+1);
/* q : ref^2 [ 7623 + 1 * initMatrixk, 4859 + -1 * initMatrixl + -1 * initMatrixk] -> 0.000000 */
/* q : ref^1 [ 4859 + -1 * i_2_q_2th + -1 * initMatrixl + -1 * initMatrixk, 4859 + -1 * i_2_q_2th + -1 * initMatrixk] -> 0.000000 */
/* initMatrixpp : ref^2 [ 0, -1 + 1 * initMatrixk] -> 1.000000 */
/* initMatrixpp : ref^1 [ 0, -1 + 1 * initMatrixl] -> 1.000000 */
} else {
}

fun_name:copyarray 
ownership
copyarrayph b : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000
copyarrayq b : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000
copyarrayph e : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000
copyarrayq e : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000
if exp then {
  } else {
  let _ = *copyarrayph in
  copyarrayq := (int);
  let p1 = copyarrayph + 1 in
/* p1 : ref^1 [ 0, -2 + 1 * copyarrayn] -> 1.000000 */
/* copyarrayph : ref^1 [ 0, 0] -> 1.000000 */
  let q1 = copyarrayq + 1 in
/* q1 : ref^1 [ 0, -2 + 1 * copyarrayn] -> 1.000000 */
/* copyarrayq : ref^1 [ 0, 0] -> 1.000000 */
  let _ = copyarray(not yet implemented, p1, q1) in
/* p1 : ref^1 [ 0, -2 + 1 * copyarrayn] -> 1.000000 */
/* q1 : ref^1 [ 0, -2 + 1 * copyarrayn] -> 1.000000 */
  alias(q1=copyarrayq+1);
/* q1 : ref^1 [ 4859 + -1 * copyarrayn, 4859 + -1 * copyarrayn] -> 0.000000 */
/* copyarrayq : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000 */
  alias(p1=copyarrayph+1);
/* p1 : ref^1 [ 4859 + -1 * copyarrayn, 4859 + -1 * copyarrayn] -> 0.000000 */
/* copyarrayph : ref^1 [ 0, -1 + 1 * copyarrayn] -> 1.000000 */
}

fun_name:copymatrix 
ownership
copymatrixpp b : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000
copymatrixpp b : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000
copymatrixqq b : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000
copymatrixqq b : ref^1 [ 0, 0] -> 0.000000
copymatrixpp e : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000
copymatrixpp e : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000
copymatrixqq e : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000
copymatrixqq e : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000
if exp then {
  } else {
  let x = *copymatrixpp in
/* x : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
/* copymatrixpp_eq0 : ref^2 [ 0, 0] -> 1.000000 */
/* copymatrixpp_eq0 : ref^1 [ 4859 + -1 * i_4_copymatrixpp_eq0_2th + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * i_4_copymatrixpp_eq0_2th + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* copymatrixpp_non0 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* copymatrixpp_non0 : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  let y = alloc copymatrixn1 : int ref in
/* y : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  let _ = copyarray(copymatrixn1, x, y) in
/* x : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
/* y : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  alias(x=*copymatrixpp);
/* x : ref^1 [ 4859 + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* copymatrixpp : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000 */
/* copymatrixpp : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  copymatrixqq := y;
/* copymatrixqq_eq0 : ref^2 [ 0, 0] -> 1.000000 */
/* copymatrixqq_eq0 : ref^1 [ 0 + -1 * i_4_copymatrixqq_eq0_2th, -1 + -1 * i_4_copymatrixqq_eq0_2th + 1 * copymatrixn1] -> 1.000000 */
/* copymatrixqq_non0 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* copymatrixqq_non0 : ref^1 [ 0, 0] -> 0.000000 */
/* y : ref^1 [ 4859 + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
  let p1 = copymatrixpp + 1 in
/* p1 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* p1 : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
/* copymatrixpp : ref^2 [ 0, 0] -> 1.000000 */
/* copymatrixpp : ref^1 [ 0 + -1 * i_4_copymatrixpp_2th, -1 + -1 * i_4_copymatrixpp_2th + 1 * copymatrixn1] -> 1.000000 */
  let q1 = copymatrixqq + 1 in
/* q1 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* q1 : ref^1 [ 0, 0] -> 0.000000 */
/* copymatrixqq : ref^2 [ 0, 0] -> 1.000000 */
/* copymatrixqq : ref^1 [ 0 + -1 * i_4_copymatrixqq_2th, -1 + -1 * i_4_copymatrixqq_2th + 1 * copymatrixn1] -> 1.000000 */
  let _ = copymatrix(copymatrixn1, not yet implemented, p1, q1) in
/* p1 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* p1 : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
/* q1 : ref^2 [ 0, -2 + 1 * copymatrixn2] -> 1.000000 */
/* q1 : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  alias(q1=copymatrixqq+1);
/* q1 : ref^2 [ 2518 + 1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* q1 : ref^1 [ 4859 + -1 * i_4_q1_2th + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * i_4_q1_2th + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* copymatrixqq : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000 */
/* copymatrixqq : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
  alias(p1=copymatrixpp+1);
/* p1 : ref^2 [ 4859 + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* p1 : ref^1 [ 4859 + -1 * i_4_p1_2th + -1 * copymatrixn1 + -1 * copymatrixn2, 4859 + -1 * i_4_p1_2th + -1 * copymatrixn1 + -1 * copymatrixn2] -> 0.000000 */
/* copymatrixpp : ref^2 [ 0, -1 + 1 * copymatrixn2] -> 1.000000 */
/* copymatrixpp : ref^1 [ 0, -1 + 1 * copymatrixn1] -> 1.000000 */
}


*/
