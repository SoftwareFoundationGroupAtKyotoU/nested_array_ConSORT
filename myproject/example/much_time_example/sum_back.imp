initx(n, x, p) 
[ <#n: int, #x: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, #x: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = initx(m, x, q) in
    alias(q=p+1);
    1
  }
}

sum(n, p) 
[ <#n: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    0
  } else {
    let m = n - 1 in
    let q = p + m in
    let y = *q in
    let s = sum(m, p) in
    alias(q=p+m);
    let z = y + s in
    z
  } 
}

{
  let p = alloc 10 : int ref in
  let m = 10 in
  let rand = _ in
  assume(rand >= 0);
  /*let z = abs(rand) in*/
  let d = initx(m, rand, p) in
  let x = sum(m, p) in
  assert(x >= 0);
  ()
}

