verifyM(s, s2, p, q)
[ <#s: int, #s2: int, 
p: int ref(0, s - 1, 1.) ref(0, s2 - 1, 1.), 
q: int ref(0, s - 1, 1.) ref(0, s2 - 1, 1.)> ->
  <#s: int, #s2: int, 
p: int ref(0, s - 1, 1.) ref(0, s2 - 1, 1.), 
q: int ref(0, s - 1, 1.) ref(0, s2 - 1, 1.) | int> ]
{
    let ind1 = _ : (ind1 >= 0 && ind1 < s) in
    let ind2 = _ : (ind2 >= 0 && ind2 < s2) in
    assert(p[ind1][ind2] < q[ind1][ind2]);
    1
}

{
    let three = 3 in
    let four = 4 in
    let p = alloc three : int ref ref in
    let q = alloc three : int ref ref in
    let d = easyMatrix(three, three, three, p) in
    let d2 = easyMatrix(three, three, four, q) in
    let d3 = verifyM(three, three, p, q) in
    ()
}