addarray(n, p, q, r) 
[ <#n: int, p: int ref, q: int ref, r: int ref> -> 
  <#n: int, p: int ref, q: int ref, r: int ref | int> ]
{
  if n <= 0 then {
    1
  } else {
    let x = *p in
    let y = *q in
    let z = x + y in
    r := z;
    let p1 = p + 1 in
    let q1 = q + 1 in
    let r1 = r + 1 in
    let m = n - 1 in
    let d = addarray(m, p1, q1, r1) in
    alias(p1 = p + 1);
    alias(q1 = q + 1);
    alias(r1 = r + 1);
    1
  }
}

abs(m)
[ <#m: int> -> <#m: int | int> ]
{
  if m >= 0 then {
    m
  } else {
    let k = -m in
    k
  }
}

initx(n, x, p) 
[ <#n: int, x: int, p: int ref> -> 
  <#n: int, x: int, p: int ref | int > ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = initx(m, x, q) in
    alias(q = p + 1);
    1
  }
}

verify(n, p)
[ <#n: int, p: int ref> -> 
  <#n: int, p: int ref | int> ]
{
  if n <= 0 then {
    1
  } else {
    let y = *p in
    assert(y >= 0);
    let q = p + 1 in
    let m = n - 1 in
    let d = verify(m, q) in
    alias(q = p + 1);
    1
  }
}

{
  let p = alloc 1000 : int ref in
  let q = alloc 1000 : int ref in
  let r = alloc 1000 : int ref in
  let m = 1000 in
  let rand = _ in
  let z = abs(rand) in
  let d = initx(m, z, p) in
  let d1 = initx(m, z, q) in
  let d2 = addarray(m, p, q, r) in
  let d3 = verify(m, r) in
  ()
}
