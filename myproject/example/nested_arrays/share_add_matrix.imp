addarray(n, p, q, r) 
[ <#n: int, p: int ref(0, n- 1, 0.1), q: int ref(0, n- 1, 0.1), r: int ref(0, n- 1, 1.)> -> 
  <#n: int, p: int ref(0, n- 1, 0.1), q: int ref(0, n- 1, 0.1), r: int ref(0, n- 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    let x = *p in
    let y = *q in
    let z = x + y in
    r := z;
    let p1 = p + 1 in
    let q1 = q + 1 in
    let r1 = r + 1 in
    let m = n - 1 in
    let d = addarray(m, p1, q1, r1) in
    alias(r1 = r + 1);
    alias(q1 = q + 1);
    alias(p1 = p + 1);
    1
  }
}

addmatrix(n1, n2, pp, qq, rr) 
[ <#n1: int, #n2: int, pp: int ref(0, n1- 1, 0.1) ref(0, n2- 1, 0.1), qq: int ref(0, n1- 1, 0.1) ref(0, n2- 1, 0.1), rr: int ref(0, 0, 0.) ref(0, n2- 1, 1.)> -> 
  <#n1: int, #n2: int, pp: int ref(0, n1- 1, 0.1) ref(0, n2- 1, 0.1), qq: int ref(0, n1- 1, 0.1) ref(0, n2- 1, 0.1), rr: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.) | int> ]
{
  if n1 > 0 && n2 > 0 then {
    let x = *pp in
    let y = *qq in
    let z = alloc n1 : int ref in
    let d = addarray(n1, x, y, z) in
    alias(x = *pp);
    alias(y = *qq);
    rr := z;
    let pp1 = pp + 1 in
    let qq1 = qq + 1 in
    let rr1 = rr + 1 in
    let m = n2 - 1 in
    let d2 = addmatrix(n1, m, pp1, qq1, rr1) in
    alias(rr1 = rr + 1);
    alias(qq1 = qq + 1);
    alias(pp1 = pp + 1);
    let in1 = _ : (in1 >= 0 && in1 < n1) in
    let in2 = _ : (in2 >= 0 && in2 < n2) in
    assert(pp[in2][in1] = 1);
    assert(qq[in2][in1] = 1);
    assert(rr[in2][in1] = 2);
    1
  } else {
    1
  }
}

{
  let undet = _ : (undet > 0) in
  let mat1 = alloc undet : {v:int| (v = 1)} ref(0, undet - 1, 1.) ref(0, undet - 1, 1.) in
  let mat3 = alloc undet : int ref ref in
  let immut mat2 = mat1 + 0 in
  let z3 = addmatrix(undet, undet, mat1, mat2, mat3) in
  let ind1 = _ : (ind1 >= 0 && ind1 < undet) in
  let ind2 = _ : (ind2 >= 0 && ind2 < undet) in
  assert(mat3[ind1][ind2] = 2);
  1
}

