    let x = *addmatrixpp in
/* x : ref^1 [ 0, -1 + 1 * addmatrixn1] -> 1.000000/10.000000 */
/* addmatrixpp_eq0 : ref^2 [ 0, 0] -> 1.000000/10.000000 */
