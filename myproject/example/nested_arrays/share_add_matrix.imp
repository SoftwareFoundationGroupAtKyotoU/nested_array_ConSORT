fun_name:addmatrix 
ownership
addmatrixpp b : ref^2 [ 0, -1 + 1 * addmatrixn2] -> 1.000000/10.000000
addmatrixpp b : ref^1 [ 0, -1 + 1 * addmatrixn1] -> 1.000000/10.000000
addmatrixqq b : ref^2 [ 0, -1 + 1 * addmatrixn2] -> 1.000000/10.000000
addmatrixqq b : ref^1 [ 0, -1 + 1 * addmatrixn1] -> 1.000000/10.000000
addmatrixrr b : ref^2 [ 0, -1 + 1 * addmatrixn2] -> 1.000000
addmatrixrr b : ref^1 [ 0, 0] -> 0.000000
addmatrixpp e : ref^2 [ 0, -1 + 1 * addmatrixn2] -> 1.000000/10.000000
addmatrixpp e : ref^1 [ 0, -1 + 1 * addmatrixn1] -> 1.000000/10.000000
addmatrixqq e : ref^2 [ 0, -1 + 1 * addmatrixn2] -> 1.000000/10.000000
