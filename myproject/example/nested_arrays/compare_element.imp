init(n1, val, p1) 
[ <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.)> -> 
  <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.) | int> ]
{
  if n1 <= 0 then {
    1
  } else {
    p1 := val;
    let q = p1 + 1 in
    let m = n1 - 1 in
    let nextval = val - 1 in
    let d = init(m, nextval, q) in
    alias(q = p1 + 1);
    1
  }
}

easyMatrix(l, k, val, pp)
[ <#l: int, #k: int, val: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, val: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, val, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    /*let nextval = val + 1 in*/
    let d2 = easyMatrix(l, m, val, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

