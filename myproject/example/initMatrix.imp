init(n, p) 
[ <#n: int, p: int ref> -> 
  <#n: int, p: int ref | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 0;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(x, y, p)
[ <#x: int , y: int, p: int ref ref> ->
    <#x: int, y: int, p: int ref ref | int> ]
{ 
    if x <= 0 then { 
        1 
    } else {
        let q = *p in
        let z = init(y, q) in
        alias(q = *p);
        let r = p + 1 in
        let w = x - 1 in
        let s = initMatrix(w, y, r) in
        alias(r=p+1);
        0
    }
}

{
  let p = alloc 10 : int ref ref in
  let x = 10 in
  let y = 0 in
  let d = initMatrix(x, y, p) in
  1
}