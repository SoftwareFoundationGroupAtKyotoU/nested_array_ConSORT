init(pin, p) 
[ <#pin: int, p: int ref (0, pin - 1, 1.) > -> 
  <#pin: int, p: int ref (0, pin - 1, 1.) | int> ]
{
  if pin <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    let m1 = pin - 1 in
    let d = init(m1, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = initMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

addarray(n, p, q, r) 
[ <#n: int, p: int ref(0, n- 1, 1.), q: int ref(0, n- 1, 1.), r: int ref(0, n- 1, 1.)> -> 
  <#n: int, p: int ref(0, n- 1, 1.), q: int ref(0, n- 1, 1.), r: int ref(0, n- 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    let x = *p in
    let y = *q in
    let z = x + y in
    r := z;
    let p1 = p + 1 in
    let q1 = q + 1 in
    let r1 = r + 1 in
    let m = n - 1 in
    let d = addarray(m, p1, q1, r1) in
    alias(r1 = r + 1);
    alias(q1 = q + 1);
    alias(p1 = p + 1);
    1
  }
}

addmatrix(n1, n2, pp, qq, rr) 
[ <#n1: int, #n2: int, pp: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.), qq: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.), rr: int ref(0, 0, 0.) ref(0, n2- 1, 1.)> -> 
  <#n1: int, #n2: int, pp: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.), qq: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.), rr: int ref(0, n1- 1, 1.) ref(0, n2- 1, 1.) | int> ]
{
  if n1 > 0 && n2 > 0 then {
    let x = *pp in
    let y = *qq in
    let z = alloc n1 : int ref in
    let d = addarray(n1, x, y, z) in
    alias(x = *pp);
    alias(y = *qq);
    rr := z;
    let pp1 = pp + 1 in
    let qq1 = qq + 1 in
    let rr1 = rr + 1 in
    let m = n2 - 1 in
    let d2 = addmatrix(n1, m, pp1, qq1, rr1) in
    alias(rr1 = rr + 1);
    alias(qq1 = qq + 1);
    alias(pp1 = pp + 1);
    1
  } else {
    1
  }
}

{
  let mat1 = alloc 4 : int ref ref in
  let mat2 = alloc 4 : int ref ref in
  let mat3 = alloc 4 : int ref ref in
  let ten = 4 in
  let z1 = initMatrix(ten, ten, mat1) in
  let z2 = initMatrix(ten, ten, mat2) in
  let z3 = addmatrix(ten, ten, mat1, mat2, mat3) in
  assert(mat3[0][0] = 2);
  1
}

