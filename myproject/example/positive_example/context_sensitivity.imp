init(n, x, p) 
[ <#n: int, #x: int, p: int ref(0, n- 1, 1.)  > -> 
  <#n: int, #x: int, p: int ref(0, n- 1, 1.)| int> ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, x, q) in
    alias(q = p + 1);
    1
  }
}

{
  let tt = alloc 10 : int ref in
  let tt2 = alloc 10 : int ref in
  let one = 1 in
  let ten = 10 in
  let d = init(ten, one, tt) in
  assert(tt[0] = 1);
  let d2 = init(ten, ten, tt2) in
  assert(tt2[0] = ten);
  ()
}

