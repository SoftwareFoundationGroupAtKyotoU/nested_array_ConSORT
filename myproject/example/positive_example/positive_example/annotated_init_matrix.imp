easyMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, l- 1, 1.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    /*let d = init(l, r) in*/
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d = easyMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}


