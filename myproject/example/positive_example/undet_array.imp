init(n, p) 
[ <#n: int, p: int ref(0, n- 1, )> -> 
  <#n: int, p: int ref(0, n- 1, ) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    alias(q=p+1);
    1
  }
}

verify(m, p)
[ <#m: int, p: int ref(0, m- 1, )> -> 
  <#m: int, p: int ref(0, m- 1, ) | int> ]
{
  if m <= 0 then {
    1
  } else {
    let index = _ : (index >= 0 && index < m) in
    assert(p[index] = 1);
    0
  }
}

{
  let unde = _ : (unde >= 1) in
  let p = alloc unde : int ref in
  let d = init(unde, p) in
  let ind1 = _ : (ind1 >= 0 && ind1 < unde) in
  /*assert(p[ind1] = 1);*/
  let d2 = verify(unde, p) in
  ()
}