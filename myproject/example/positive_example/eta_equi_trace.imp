/* mat2 : ref^1 [ 0, -1 + 1 * ten] -> 1.000000/10.000000 */
/* mat1 : ref^2 [ 0, -1 + 1 * ten] -> 9.000000/10.000000 */
/* mat1 : ref^1 [ 0, -1 + 1 * ten] -> 9.000000/10.000000 */
