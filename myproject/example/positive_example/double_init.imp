init(n, x, p) 
[ <#n: int, #x: int, p: int ref  > -> 
  <#n: int, #x: int, p: int ref| int> ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, x, q) in
    1
  }
}

