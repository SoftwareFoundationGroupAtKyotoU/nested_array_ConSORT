init(n, p) 
[ <#n: int, p: int ref (0, n - 1, 1.) > -> 
  <#n: int, p: int ref (0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 1;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    alias(q=p+1);
    1
  }
}



easyMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, l- 1, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: {v:int| (=> ((((i1 >= 0) and (i1 < l)) and (i2 >= 0)) and (i2 < k)) (v = 1))} ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = easyMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

verify(s, s2, q)
[ <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.)> ->
    <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.) | int> ]
{
  if s > 0 then { 
    let ind1 = _ : (ind1 >= 0 && ind1 < s) in
    let ind2 = _ : (ind2 >= 0 && ind2 < s) in
    assert(q[ind1][ind2] = 1);
    1
  } else {
    0
  }
}


{
  let ten = _ : (ten > 0) in
  let pp = alloc ten : int ref ref in
  let d = easyMatrix(ten, ten, pp) in
  let d2 = verify(ten, ten, pp) in
  ()
}

