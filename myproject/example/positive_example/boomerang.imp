init(n, x, p) 
[ <#n: int, x: int, p: int ref (0, n - 1, 1.) > -> 
  <#n: int, x: int, p: int ref (0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := x;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, x, q) in
    alias(q=p+1);
    1
  }
}



easyMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, l- 1, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let zero = 0 in
    let d = init(l, zero, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d = easyMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

boomerang(b1, b2, r)
[ <#b1: int, #b2: int, r: int ref(0, b1 - 1, 1.) ref(0, b2 - 1, 1.)> ->
    <#b1: int, #b2: int, r: int ref(0, b1 - 1, 1.) ref(0, b2 - 1, 1.) | int> ]
{
  if b2 > 0 && b1 > 0 then {
    let t = *r in
    let uu = 1 in
    let f = init(b1, uu, t) in
    alias(t = *r);
    let b3 = b2 - 1 in
    let t2 = r+ 1 in
    let b4 = boomerang(b1, b3, t2) in
    alias(t2 = r+ 1);
    0
  } else {
    0
  }
}

verify(s, s2, q)
[ <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.)> ->
    <#s: int, #s2: int, q: int ref(0, s - 1, 1.) ref(0, s - 1, 1.) | int> ]
{
  if s >= 0 && s2 >= 0 && s2 < s then { 
    assert(q(s2, 0) = 0);
    1
  } else {
    0
  }
}


{
  let kp = alloc 10 : int ref ref in
  let ten = 10 in
  let zero = 0 in
  let one = 1 in
  let d = easyMatrix(ten, ten, kp) in
  let d2 = verify(ten, zero, kp) in
  let d3 = boomerang(ten, ten,  kp) in
  let d4 = verify(ten, zero, kp) in
  ()
}