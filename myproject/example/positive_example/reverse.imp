
reverse(n, ph, q)
[ <#n: int, ph: int ref(0, n- 1, ), q: int ref(0, n- 1, ) > -> 
  <#n: int, ph: int ref(0, n- 1, ), q: int ref(0, n - 1, ) | int> ]
{
  if n <= 0 then {
    1
  } else {
    let l = n - 1 in
    let qShift = q + l in
    let x = *qShift in
    ph := x;
    let phShift = ph + 1 in
    let d = reverse(l, phShift, q) in
    alias(qShift = q + l);
    alias(phShift = ph + 1);
    1
  }
}

{
  let unde = _ : (unde > 0) in
  let mat1 = alloc unde : {v:int| (v = i1)} ref(0, unde - 1, 1.) in
  let mat2 = alloc unde : int ref in
  let d = reverse(unde, mat2, mat1) in
  let ind1 = _ : (ind1 >= 0 && ind1 < unde) in
  assert(mat2[ind1] = unde - ind1 - 1);
  1
}

