trace(n, k, p, r)
[ <#n: int, #k: int, p: int ref(0, n- 1, 1.) ref(0, n- 1, 1.), r: int ref(0, 0, 1.)> -> 
  <#n: int, #k: int, p: int ref(0, n- 1, 1.) ref(0, n- 1, 1.), r: int ref(0, 0, 1.)| int> ]
{
  if n <= 0 then {
    -1
  } else {
    if k <= 0 || k >= n then {
        let pp = *p in
        let d = *pp in
        alias(pp = *p);
        r := d;
        1
    } else {
        let q = p + k in
        let qq = *q in
        let s = qq + k in
        let d1 = *s in
        alias(s = qq + k);
        alias(qq = *q);
        alias(q = p + k);
        /*let l = k - 1 in
        let d2 = trace(n, l, p, r) in
        let d3 = *r in
        let d4 = d1 + d3 in
        r := d4;*/
        1
    }
  }
}

{
  0
}