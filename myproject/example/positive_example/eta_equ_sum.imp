init(n1, val, p1) 
[ <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.)> -> 
  <#n1: int, #val: int, p1: {v:int| (=> ((i1 >= 0) and (i1 < n1)) (v = val))} ref(0, n1- 1, 1.) | int> ]
{
  if n1 <= 0 then {
    1
  } else {
    p1 := val;
    let q = p1 + 1 in
    let m = n1 - 1 in
    let d = init(m, val, q) in
    alias(q = p1 + 1);
    1
  }
}

sum(n, p) 
[ <#n: int, p: int ref(0, n- 1, 1.)> -> 
  <#n: int, p: int ref(0, n- 1, 1.) | int> ]
{
  if n <= 0 then {
    0
  } else {
    let x = *p in
    let q = p + 1 in
    let m = n - 1 in
    let s = sum(m, q) in
    alias(q = p + 1);
    let y = x + s in
    y
  }
}

sumback(n, p) 
[ <#n: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    0
  } else {
    let m = n - 1 in
    let q = p + m in
    let y = *q in
    assert(y >= 0);
    let s = sumback(m, p) in
    alias(q=p+m);
    let z = y + s in
    z
  } 
}

{
  let unde = _ : (unde >= 1) in
  let p = alloc unde : int ref in
  let unde2 = 1 in
  let d = init(unde, unde2, p) in
  let x = sum(unde, p) in
  let y = sumback(unde, p) in
  let t = unde * unde2 in
  assert(x = y);
  ()
}

