init(n, p) 
[ <#n: int, p: int ref> -> 
  <#n: int, p: int ref | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 0;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    alias(q=p+1);
    1
  }
}

easyMatrix(n, pp)
[ <#n: int, pp: int ref ref> ->
    <#n: int, pp: int ref ref | int> ]
{ 
  if n <= 0 then { 
        1 
  } else {
    let r = alloc 10 : int ref in
    let ten = 10 in
    let d = init(ten, r) in
    pp := r;
    let q = pp + 1 in
    let m = n - 1 in
    let d2 = easyMatrix(m, q) in
    alias(q=pp+1);
    0
  }
}

{
  let p = alloc 10 : int ref ref in
  let x = 10 in
  let d = easyMatrix(x, p) in
  let y = *p in
  1
}