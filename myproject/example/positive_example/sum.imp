init(n1, val, p1) 
[ <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.)> -> 
  <#n1: int, #val: int, p1: int ref(0, n1- 1, 1.) | int> ]
{
  if n1 <= 0 then {
    1
  } else {
    p1 := val;
    let q = p1 + 1 in
    let m = n1 - 1 in
    let d = init(m, val, q) in
    alias(q = p1 + 1);
    1
  }
}

sum(n, p) 
[ <#n: int, p: int ref(0, n- 1, 1.)> -> 
  <#n: int, p: int ref(0, n- 1, 1.) | int> ]
{
  if n <= 0 then {
    0
  } else {
    let x = *p in
    let q = p + 1 in
    let m = n - 1 in
    let s = sum(m, q) in
    alias(q = p + 1);
    let y = x + s in
    y
  }
}

{
  let arr = alloc 10 : int ref in
  let m = 10 in
  let one = 1 in
  let d = init(m, one, arr) in
  let x = sum(m, arr) in
  assert(x = 10);
  ()
}