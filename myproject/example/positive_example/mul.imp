init(pin, p) 
[ <#pin: int, p: int ref (0, pin - 1, 1.) > -> 
  <#pin: int, p: int ref (0, pin - 1, 1.) | int> ]
{
  if pin <= 0 then {
    1
  } else {
    p := 0;
    let q = p + 1 in
    let m1 = pin - 1 in
    let d = init(m1, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d = initMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

scalarMult(ll, co, be) 
[ <#ll: int, co: int, be: int ref (0, ll - 1, 1.) > -> 
  <#ll: int, co: int, be: int ref (0, ll - 1, 1.) | int> ]
{
  if ll <= 0 then {
    1
  } else {
    let x = *be in
    let y = co * x in
    be := y;
    let ne = be + 1 in
    let m1 = ll - 1 in
    let d = scalarMult(m1, co, ne) in
    alias(ne = be + 1);
    1
  }
}

scalarMultMatrix(n1, n2, coef, q) 
[ <#n1: int, #n2: int, coef: int, q: int ref (0, n1 - 1, 1.) ref(0, n2- 1, 1.) > -> 
  <#n1: int, #n2: int, coef: int, q: int ref (0, n1 - 1, 1.) ref(0, n2- 1, 1.) | int> ]
{
  if n1 > 0 && n2 > 0 then {
    let qin = *q in
    let d = scalarMult(n1, coef, qin) in
    alias(qin = *q);
    let q2 = q + 1 in
    let m = n2 - 1 in
    let d2 = scalarMultMatrix(n1, m, coef, q2) in
    alias(q2 = q + 1);
    0
  } else {
    0
  }
}

{
  let p = alloc 10 : int ref ref in
  let x = 10 in
  let y = 10 in
  let zero = 0 in
  let d = initMatrix(x, y, p) in
  let d2 = scalarMultMatrix(x, y, zero, p) in
  let h = *p in
  let hin = *h in
  assert(hin = 0);
  alias(h = *p);
  1
}