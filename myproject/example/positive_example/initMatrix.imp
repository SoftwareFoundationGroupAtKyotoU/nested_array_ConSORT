init(n, p) 
[ <#n: int, p: int ref(0, n - 1, 1.)> -> 
  <#n: int, p: int ref(0, n - 1, 1.) | int> ]
{
  if n <= 0 then {
    1
  } else {
    p := 0;
    let q = p + 1 in
    let m = n - 1 in
    let d = init(m, q) in
    alias(q=p+1);
    1
  }
}

initMatrix(l, k, pp)
[ <#l: int, #k: int, pp: int ref(0, 0, 0.) ref(0, k - 1, 1.)> ->
    <#l: int, #k: int, pp: int ref(0 , l- 1, 1.) ref(0, k - 1, 1.) | int> ]
{ 
  if k > 0 && l > 0 then { 
    let r = alloc l : int ref in
    let d = init(l, r) in
    pp := r;
    let q = pp + 1 in
    let m = k - 1 in
    let d2 = initMatrix(l, m, q) in
    alias(q=pp+1);
    0
  } else {
    0
  }
}

{
  let p = alloc 10 : int ref ref in
  let x = 10 in
  let d = initMatrix(x, x, p) in
  let ind1 = _ : (ind1 >= 0 && ind1 < 10) in
  let ind2 = _ : (ind2 >= 0 && ind2 < 10) in
  assert(p[ind1][ind2] = 0);
  1
}