copyarray(n, val, p, q)
[ <#n: int, val: int, p: int ref(0, n - 1, ), q: int ref(0, n - 1, )> -> 
  <#n: int, val: int, p: int ref(0, n - 1, ), q: 
  int ref(0, n - 1, ) | int> ]
{
  if n <= 0 then {
    1
  } else {
    let x = *p in
    q := x;
    let p1 = p + 1 in
    let q1 = q + 1 in
    let m = n - 1 in
    let d = copyarray(m, val, p1, q1) in
    alias(q1 = q + 1);
    alias(p1 = p + 1);
    1
  }
}

swaprow(l, pp)
[ <#l: {v:int| (v > 5)},  
pp: int ref(0, l - 1, ) ref(0, l- 1, )> -> 
  <#l: int,
pp: int
ref(0, l - 1, ) ref(0, l- 1, )| int> ]
{
  if l > 2  then {
    let n1 = 0 in
    let n2 = 1 in
    let immut ppShift1 = pp + 0 in
    let row1 = *ppShift1 in
    let dummy1 = alloc l : int ref in
    let d = copyarray(l, n1, row1, dummy1) in
    alias(row1 = *ppShift1);
    alias(ppShift1 = pp + n1);

    let ppShift2 = pp + n2 in
    let row2 = *ppShift2 in
    let dummy2 = alloc l : int ref in
    let d2 = copyarray(l, n2, row2, dummy2) in
    let d3 = copyarray(l, n1, dummy1, row2) in
    alias(row2 = *ppShift2);
    alias(ppShift2 = pp + n2);

    let ppShift3 = pp + n1 in
    let row3 = *ppShift3 in
    let d4 = copyarray(l, n2, dummy2, row3) in
    alias(row3 = *ppShift3);
    alias(ppShift3 = pp + n1);
    1

  } else { 0 }
}

{
  let unde = _ : (unde > 5) in
  let zero = 0 in
  let one = 1 in
  let mat1 = alloc unde : {v:int| ((=> (i2 = 1) (v = 2)) and (=> (i2 = 0) (v = 6)))}  
  ref(0, unde - 1, 1.) ref(0, unde - 1, 1.) in
  let d = swaprow(unde, mat1) in
  let ind1 = _ : (ind1 >= 0 && ind1 < unde) in
  assert(mat1[1][ind1] = 6);
  assert(0 = 0);
  1
}

